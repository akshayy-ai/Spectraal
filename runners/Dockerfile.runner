# SDD Software Factory — Self-Contained Runner Image
# =====================================================
# Build: docker build -t sdd-runner -f runners/Dockerfile.runner .
# Run:   docker run -v /var/run/docker.sock:/var/run/docker.sock \
#                   -e ANTHROPIC_API_KEY="your-key" \
#                   sdd-runner "Build a task management app"

FROM node:22-alpine

# Install system dependencies
RUN apk add --no-cache \
    bash \
    curl \
    jq \
    openssl \
    git \
    docker-cli \
    docker-cli-compose

# Install Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code

# Create working directory
WORKDIR /sdd

# Copy SDD framework
COPY config.yaml ./
COPY factory.sh ./
COPY schemas/ ./schemas/
COPY prompts/ ./prompts/
COPY scripts/ ./scripts/
COPY blueprints/ ./blueprints/
COPY runners/ ./runners/

# Make scripts executable
RUN chmod +x factory.sh scripts/*.sh scripts/lib/*.sh

# Create builds directory
RUN mkdir -p builds logs

ENTRYPOINT ["./factory.sh"]

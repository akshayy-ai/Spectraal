# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:{{DB_PORT}}/{{DB_NAME}}

# JWT
JWT_SECRET={{JWT_SECRET}}
JWT_EXPIRES_MINUTES=10080

# Server (uvicorn port is set in Dockerfile CMD, not via env var)
ENVIRONMENT=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:{{FE_PORT}}
